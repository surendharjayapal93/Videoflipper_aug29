# .env.example
# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
# Individual pieces used to build the compose-internal DATABASE_URL, and to
# configure the postgres service itself.
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=videoflipper
# Full SQLAlchemy connection string. When running via docker-compose this is
# assembled from the DB_* vars above (host "postgres"); override directly for
# local (non-docker) backend runs, e.g. postgresql://user:pass@localhost:5432/db
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/videoflipper

# --- Auth / JWT ---
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage (downloaded source + flipped output files) ---
STORAGE_BUCKET=videoflipper-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Frontend ---
# Base URL the frontend uses to reach the API. Baked in at build time for
# static builds; used directly by Vite dev server otherwise.
VITE_API_URL=http://localhost:8000
